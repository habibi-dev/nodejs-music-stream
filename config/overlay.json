{
  "cover": {
    "enabled": true,
    "path": "src/assets/images/cover.png",
    "fps": 30,
    "scale": "1280:720",
    "force_ratio": "decrease"
  },
  "logo": {
    "enabled": false,
    "path": "src/assets/images/logo.png",
    "position": "top-left",
    "scale": "10%",
    "margin": {
      "x": 20,
      "y": 20
    }
  },
  "text": {
    "enabled": true,
    "now_playing": {
      "enabled": true,
      "position": "bottom-left",
      "font": "/Windows/Fonts/arial.ttf",
      "size": 24,
      "color": "0xffd900",
      "background": "0x000000@0.8",
      "padding": 10,
      "template": "Now Playing: {title}"
    },
    "time": {
      "enabled": true,
      "position": "top-right",
      "font": "/Windows/Fonts/arial.ttf",
      "size": 18,
      "padding": 10,
      "color": "0xffd900",
      "background": "0x000000@0.8"
    }
  }
}